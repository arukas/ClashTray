<UserControl x:Class="ClashTray.App.ProxyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ProxySecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="2">
        <StackPanel x:Name="ProviderSection" Visibility="Collapsed">
            <Button Style="{StaticResource ClashTrayRowButtonStyle}" MinHeight="34" Padding="6,4" Click="ToggleProviders_Click">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProviderTitle" Text="代理提供者" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                    <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="12"/>
                </Grid>
            </Button>
            <StackPanel x:Name="ProvidersPanel" Spacing="6" Margin="8,0" Visibility="Collapsed"/>
        </StackPanel>
        <Grid Margin="6,6,6,4">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="代理组" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
            <TextBlock x:Name="NodeCountText" Grid.Column="1" Text="0 组" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
        </Grid>
        <StackPanel x:Name="GroupsPanel" Spacing="4"/>
        <StackPanel x:Name="EmptyState" Spacing="8" Margin="14,16" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE839;" FontSize="26" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="EmptyTitle" Text="还没有代理组" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyHint" Text="点击上方“切换配置”导入 YAML 或订阅，&#xA;启动核心后，代理组与节点会显示在这里。" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
        </StackPanel>
        <TextBlock x:Name="DelayText" TextWrapping="Wrap" Margin="6,4" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
</UserControl>
