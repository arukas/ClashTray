<UserControl
    x:Class="ClashTray.App.ProxyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="8" Padding="0,12,0,0">
        <TextBlock Text="代理组与节点" FontSize="16" FontWeight="SemiBold" />
        <ComboBox x:Name="GroupComboBox" PlaceholderText="选择代理组" SelectionChanged="GroupComboBox_SelectionChanged" />
        <ListView x:Name="NodeListView" MaxHeight="180" SelectionChanged="NodeListView_SelectionChanged" AutomationProperties.Name="代理节点列表" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="测试延迟" Click="TestDelayButton_Click" />
            <TextBlock x:Name="DelayText" Text="尚未测试" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </StackPanel>
</UserControl>
