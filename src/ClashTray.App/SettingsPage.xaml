<UserControl
    x:Class="ClashTray.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="10" Padding="0,2,0,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE713;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1">
                <TextBlock x:Uid="SettingsTitle" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Uid="SettingsSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                <TextBlock x:Uid="SettingsSaveHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource ClashTrayCardStyle}">
            <StackPanel Spacing="2">
                <TextBlock x:Uid="RunModeHeader" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ToggleSwitch x:Name="StartWithWindowsSwitch" x:Uid="StartWithWindowsSwitch" />
                <ToggleSwitch x:Name="StartCoreSwitch" x:Uid="StartCoreSwitch" />
                <ToggleSwitch x:Name="AllowLanSwitch" x:Uid="AllowLanSwitch" />
                <ToggleSwitch x:Name="Ipv6Switch" x:Uid="Ipv6Switch" />
                <ToggleSwitch x:Name="TcpConcurrentSwitch" x:Uid="TcpConcurrentSwitch" />
                <ToggleSwitch x:Name="DisconnectAfterProxySwitch" x:Uid="DisconnectAfterProxySwitch" />
                <TextBlock x:Uid="DisconnectAfterProxySwitchHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                <TextBlock x:Uid="RestartOnChangeHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                <TextBlock x:Uid="ProgramOverridesHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
                <TextBlock x:Name="StartupStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />
                <Button x:Name="SaveSettingsButton" x:Uid="SaveSettingsButton" Style="{StaticResource ClashTrayCompactButtonStyle}" Click="SaveButton_Click" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource ClashTrayCardStyle}">
            <StackPanel Spacing="8">
                <TextBlock x:Uid="NetworkSwitchHeader" FontWeight="SemiBold" />
                <ToggleSwitch x:Name="NetworkSwitchEnabledSwitch" x:Uid="NetworkSwitchEnabledSwitch" />
                <ComboBox x:Name="NetworkSwitchDefaultConfigurationBox" x:Uid="NetworkSwitchDefaultConfigurationBox" />
                <TextBlock x:Name="NetworkSwitchStateText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock x:Uid="NetworkSwitchHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                    <Button x:Name="SaveNetworkSwitchButton" x:Uid="SaveNetworkSwitchButton" Style="{StaticResource ClashTrayCompactButtonStyle}" Click="SaveNetworkSwitchButton_Click" />
                    <Button x:Name="ResumeNetworkSwitchButton" x:Uid="ResumeNetworkSwitchButton" Style="{StaticResource ClashTrayCompactButtonStyle}" Click="ResumeNetworkSwitchButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource ClashTrayCardStyle}">
            <StackPanel Spacing="8">
                <TextBlock x:Uid="PortsHeader" FontWeight="SemiBold" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox x:Name="HttpPortBox" Header="HTTP" Minimum="1" Maximum="65535" />
                    <NumberBox x:Name="SocksPortBox" Grid.Column="1" Header="SOCKS" Minimum="1" Maximum="65535" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox x:Name="MixedPortBox" Header="Mixed" Minimum="1" Maximum="65535" />
                    <NumberBox x:Name="ControllerPortBox" Grid.Column="1" x:Uid="ControllerPortBox" Minimum="1" Maximum="65535" />
                </Grid>
                <TextBox x:Name="BypassListBox" x:Uid="BypassListBox" />
                <TextBlock x:Uid="SubscriptionRefreshHeader" FontWeight="SemiBold" Margin="0,2,0,0" />
                <NumberBox x:Name="SubscriptionRefreshHoursBox" x:Uid="SubscriptionRefreshHoursBox" Minimum="1" Maximum="168" SmallChange="1" Value="24" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource ClashTrayCardStyle}">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="LogLevelBox" x:Uid="LogLevelBox" SelectedIndex="0">
                        <ComboBoxItem Content="info" Tag="info" />
                        <ComboBoxItem Content="warning" Tag="warning" />
                        <ComboBoxItem Content="error" Tag="error" />
                        <ComboBoxItem Content="debug" Tag="debug" />
                    </ComboBox>
                    <ComboBox x:Name="ThemeBox" Grid.Column="1" x:Uid="ThemeBox">
                        <ComboBoxItem x:Uid="ThemeSystemItem" Tag="system" />
                        <ComboBoxItem x:Uid="ThemeLightItem" Tag="light" />
                        <ComboBoxItem x:Uid="ThemeDarkItem" Tag="dark" />
                    </ComboBox>
                </Grid>
                <ComboBox x:Name="LanguageBox" x:Uid="LanguageBox">
                    <ComboBoxItem x:Uid="LanguageSystemItem" Tag="system" />
                    <ComboBoxItem x:Uid="LanguageZhCNItem" Tag="zh-CN" />
                    <ComboBoxItem x:Uid="LanguageEnUSItem" Tag="en-US" />
                </ComboBox>
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">

                    <Button x:Uid="ClearDnsButton" Style="{StaticResource ClashTrayCompactButtonStyle}" Click="ClearDnsButton_Click" />
                    <Button x:Uid="ClearFakeIpButton" Style="{StaticResource ClashTrayCompactButtonStyle}" Click="ClearFakeIpButton_Click" />
                    <Button x:Uid="UpdateGeoButton" Style="{StaticResource ClashTrayCompactButtonStyle}" Click="UpdateGeoButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource ClashTrayCardStyle}">
            <StackPanel Spacing="8">
                <TextBlock x:Uid="ProvidersHeader" FontWeight="SemiBold" />
                <ListView x:Name="ProvidersListView" x:Uid="ProvidersListView" SelectionChanged="ProvidersListView_SelectionChanged" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                <Button x:Uid="RefreshProviderButton" Style="{StaticResource ClashTrayCompactButtonStyle}" Click="RefreshProviderButton_Click" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource ClashTrayCardStyle}">
            <Expander x:Uid="CoreUpdateExpander">
                <StackPanel Spacing="8" Padding="0,8,0,0">
                    <TextBox x:Name="CoreVersionBox" x:Uid="CoreVersionBox" />
                    <TextBox x:Name="CoreDownloadUriBox" x:Uid="CoreDownloadUriBox" />
                    <TextBox x:Name="CoreSha256Box" x:Uid="CoreSha256Box" />
                    <Button x:Uid="InstallCoreButton" Style="{StaticResource ClashTrayCompactButtonStyle}" Click="InstallCoreButton_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Expander>
        </Border>

        <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Padding="4,0" />
    </StackPanel>
</UserControl>

