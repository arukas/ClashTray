<UserControl
    x:Class="ClashTray.App.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="8" Padding="0,12,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="实时日志" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="复制" Click="CopyButton_Click" Margin="8,0,0,0" />
            <Button Grid.Column="2" Content="清空" Click="ClearButton_Click" Margin="8,0,0,0" />
        </Grid>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="搜索日志" TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="LevelBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="LevelBox_SelectionChanged">
                <ComboBoxItem Content="全部" />
                <ComboBoxItem Content="info" />
                <ComboBoxItem Content="warning" />
                <ComboBoxItem Content="error" />
            </ComboBox>
            <ComboBox x:Name="SourceBox" Grid.Column="2" SelectedIndex="0" SelectionChanged="SourceBox_SelectionChanged">
                <ComboBoxItem Content="全部来源" />
                <ComboBoxItem Content="ClashTray" />
                <ComboBoxItem Content="mihomo" />
            </ComboBox>
        </Grid>
        <ListView x:Name="LogsListView" MaxHeight="260" AutomationProperties.Name="日志列表" />
    </StackPanel>
</UserControl>
