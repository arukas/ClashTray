<UserControl x:Class="ClashTray.App.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:ClashTray.App">
    <StackPanel Spacing="10" Padding="0,2,0,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1">
                <TextBlock x:Uid="SettingsTitle" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Uid="SettingsSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                <TextBlock x:Uid="SettingsSaveHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <Border Style="{StaticResource ClashTrayCardStyle}">
            <StackPanel Spacing="2">
                <TextBlock x:Uid="RunModeHeader" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ToggleSwitch x:Name="StartWithWindowsSwitch" x:Uid="StartWithWindowsSwitch" />
                <ToggleSwitch x:Name="StartCoreSwitch" x:Uid="StartCoreSwitch" />
                <ToggleSwitch x:Name="DisconnectAfterProxySwitch" x:Uid="DisconnectAfterProxySwitch" />
                <TextBlock x:Uid="DisconnectAfterProxySwitchHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                <TextBlock x:Uid="SubscriptionRefreshHeader" FontWeight="SemiBold" Margin="0,6,0,0" />
                <NumberBox ValidationMode="Disabled" x:Name="SubscriptionRefreshHoursBox" x:Uid="SubscriptionRefreshHoursBox" Minimum="1" Maximum="168" SmallChange="1" Value="24" />
                <TextBlock x:Name="StartupStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />
                <Button x:Name="SaveSettingsButton" x:Uid="SaveSettingsButton" Style="{StaticResource ClashTrayCompactButtonStyle}" Click="SaveButton_Click" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
        <TextBlock x:Uid="NetworkConfigurationHeader" FontSize="16" FontWeight="SemiBold" Margin="4,8,0,0" />
        <Border Style="{StaticResource ClashTrayCardStyle}">
            <StackPanel Spacing="8">
                <Grid MinHeight="36" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="SystemProxyLabel" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="SystemProxyStateText" x:Uid="SystemProxyStateText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="2" x:Name="SystemProxySwitch" x:Uid="SystemProxySwitch" Width="46" MinWidth="0" MinHeight="0" Height="36" OnContent="" OffContent="" Toggled="SystemProxySwitch_Toggled" HorizontalAlignment="Right" />
                </Grid>
                <Grid MinHeight="36" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="TunLabel" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="TunStateText" x:Uid="TunStateText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="2" x:Name="TunSwitch" x:Uid="TunSwitch" Width="46" MinWidth="0" MinHeight="0" Height="36" OnContent="" OffContent="" Toggled="TunSwitch_Toggled" HorizontalAlignment="Right" />
                </Grid>
                <ComboBox x:Name="TunStackBox" x:Uid="TunStackBox" SelectedIndex="0">
                    <ComboBoxItem x:Uid="TunStackConfigurationItem" Tag="configuration" />
                    <ComboBoxItem x:Uid="TunStackSystemItem" Tag="system" />
                    <ComboBoxItem x:Uid="TunStackGvisorItem" Tag="gvisor" />
                    <ComboBoxItem x:Uid="TunStackMixedItem" Tag="mixed" />
                    <ComboBoxItem x:Uid="TunStackMipsItem" Tag="mips" />
                </ComboBox>
                <TextBlock x:Uid="NetworkConfigurationRestartHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />
                <TextBlock x:Uid="NetworkConfigurationImmediateHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />
                <ToggleSwitch x:Name="AllowLanSwitch" x:Uid="AllowLanSwitch" />
                <ToggleSwitch x:Name="Ipv6Switch" x:Uid="Ipv6Switch" />
                <ToggleSwitch x:Name="TcpConcurrentSwitch" x:Uid="TcpConcurrentSwitch" />
                <TextBlock x:Uid="ProgramOverridesHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                <TextBlock x:Uid="PortsHeader" FontWeight="SemiBold" Margin="0,4,0,0" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox ValidationMode="Disabled" x:Name="HttpPortBox" x:Uid="HttpPortBox" Minimum="1" Maximum="65535" />
                    <NumberBox ValidationMode="Disabled" x:Name="SocksPortBox" x:Uid="SocksPortBox" Grid.Column="1" Minimum="1" Maximum="65535" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox ValidationMode="Disabled" x:Name="MixedPortBox" x:Uid="MixedPortBox" Minimum="1" Maximum="65535" />
                    <NumberBox ValidationMode="Disabled" x:Name="ControllerPortBox" Grid.Column="1" x:Uid="ControllerPortBox" Minimum="1" Maximum="65535" />
                </Grid>
                <ComboBox x:Name="ControllerPortPolicyBox" x:Uid="ControllerPortPolicyBox">
                    <ComboBoxItem x:Uid="ControllerPortAutomaticItem" Tag="automatic" />
                    <ComboBoxItem x:Uid="ControllerPortFixedItem" Tag="fixed" />
                </ComboBox>
                <TextBlock x:Name="ActiveControllerAddressText" x:Uid="ActiveControllerAddressText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock x:Uid="ControllerPortPolicyHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />
                <Button x:Name="StartWithAvailableControllerPortButton" x:Uid="StartWithAvailableControllerPortButton" Style="{StaticResource ClashTrayCompactButtonStyle}" Click="StartWithAvailableControllerPortButton_Click" HorizontalAlignment="Left" />
                <TextBox x:Name="BypassListBox" x:Uid="BypassListBox" />
                <Button x:Name="SaveNetworkSettingsButton" x:Uid="SaveNetworkSettingsButton" Style="{StaticResource ClashTrayCompactButtonStyle}" Click="SaveButton_Click" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
        <!-- Wi-Fi/SSID switching is deferred beyond the 0.3.0 Beta. The model
             and runtime seam remain for a later release, but the Beta does not
             expose SSID rules or network monitoring in the settings UI. -->
        <local:NetworkRuleSettingsSection x:Name="NetworkRuleSection" Visibility="Collapsed" />
        <local:EndpointSettingsSection x:Name="EndpointSection" />
        <Border Style="{StaticResource ClashTrayCardStyle}">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="LogLevelBox" x:Uid="LogLevelBox" SelectedIndex="0">
                        <ComboBoxItem x:Uid="LogLevelInfoItem" Tag="info" />
                        <ComboBoxItem x:Uid="LogLevelWarningItem" Tag="warning" />
                        <ComboBoxItem x:Uid="LogLevelErrorItem" Tag="error" />
                        <ComboBoxItem x:Uid="LogLevelDebugItem" Tag="debug" />
                    </ComboBox>
                    <ComboBox x:Name="ThemeBox" Grid.Column="1" x:Uid="ThemeBox">
                        <ComboBoxItem x:Uid="ThemeSystemItem" Tag="system" />
                        <ComboBoxItem x:Uid="ThemeLightItem" Tag="light" />
                        <ComboBoxItem x:Uid="ThemeDarkItem" Tag="dark" />
                    </ComboBox>
                </Grid>
                <ComboBox x:Name="LanguageBox" x:Uid="LanguageBox">
                    <ComboBoxItem x:Uid="LanguageSystemItem" Tag="system" />
                    <ComboBoxItem x:Uid="LanguageZhCNItem" Tag="zh-CN" />
                    <ComboBoxItem x:Uid="LanguageEnUSItem" Tag="en-US" />
                </ComboBox>
            </StackPanel>
        </Border>
        <local:ProviderSettingsSection x:Name="ProviderSection" />
        <local:CoreUpdateSettingsSection x:Name="CoreUpdateSection" />
        <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Padding="4,0" />
    </StackPanel>
</UserControl>
