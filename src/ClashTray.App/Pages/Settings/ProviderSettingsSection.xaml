<UserControl x:Class="ClashTray.App.ProviderSettingsSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:ClashTray.App">
    <StackPanel Spacing="10">
        <Border Style="{StaticResource ClashTrayCardStyle}">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                    <Button x:Name="ClearDnsButton" x:Uid="ClearDnsButton" Style="{StaticResource ClashTrayCompactButtonStyle}" Click="ClearDnsButton_Click" />
                    <Button x:Name="ClearFakeIpButton" x:Uid="ClearFakeIpButton" Style="{StaticResource ClashTrayCompactButtonStyle}" Click="ClearFakeIpButton_Click" />
                    <Button x:Name="UpdateGeoButton" x:Uid="UpdateGeoButton" Style="{StaticResource ClashTrayCompactButtonStyle}" Click="UpdateGeoButton_Click" />
                </StackPanel>
                <TextBlock x:Uid="ProvidersHeader" FontWeight="SemiBold" />
                <ListView x:Name="ProvidersListView" x:Uid="ProvidersListView" SelectionChanged="ProvidersListView_SelectionChanged" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ProviderSettingsRow">
                            <TextBlock Text="{x:Bind DisplayText}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button x:Name="RefreshProviderButton" x:Uid="RefreshProviderButton" Style="{StaticResource ClashTrayCompactButtonStyle}" Click="RefreshProviderButton_Click" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>