<UserControl x:Class="ClashTray.App.ProxyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ProxySecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="8">

        <Grid ColumnSpacing="12" Margin="2,0,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock x:Uid="ProxyGroupsTitle" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock x:Name="NodeCountText" x:Uid="NodeCountText" FontSize="12" Style="{StaticResource ProxySecondaryText}"/>
            </StackPanel>
            <TextBox Grid.Column="1" x:Name="NodeSearchBox" x:Uid="NodeSearchBox" TextChanged="NodeSearchBox_TextChanged" FontSize="12" MinHeight="32"/>
        </Grid>
        <StackPanel x:Name="GroupsPanel" Spacing="8"/>
        <StackPanel x:Name="ProviderSection" Visibility="Collapsed">
            <Button Style="{StaticResource ClashTrayRowButtonStyle}" MinHeight="34" Padding="6,4" Click="ToggleProviders_Click">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProviderTitle" x:Uid="ProviderTitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                    <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="12"/>
                </Grid>
            </Button>
            <StackPanel x:Name="ProvidersPanel" Spacing="6" Margin="8,0" Visibility="Collapsed"/>
        </StackPanel>
        <TextBlock x:Name="NoResultsText" x:Uid="NoResultsText" Visibility="Collapsed" TextWrapping="Wrap" Margin="6,8" Style="{StaticResource ProxySecondaryText}"/>
        <StackPanel x:Name="EmptyState" Spacing="8" Margin="14,16" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE839;" FontSize="26" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="EmptyTitle" x:Uid="EmptyTitle" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyHint" x:Uid="EmptyHint" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
        </StackPanel>
        <TextBlock AutomationProperties.LiveSetting="Polite" x:Name="DelayText" TextWrapping="Wrap" Margin="6,4" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
</UserControl>
