<UserControl
    x:Class="ClashTray.App.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClashTray.App">
    <Grid RowSpacing="10" Padding="0,2,0,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE71B;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="10,0,8,0" Spacing="1">
                <TextBlock x:Uid="ConnectionsTitle" Style="{StaticResource ClashTrayPageTitleStyle}" />
                <TextBlock x:Uid="ConnectionsSubtitle" Style="{StaticResource ClashTrayPageSubtitleStyle}" />
            </StackPanel>
            <Button Grid.Column="2" x:Name="CloseAllButton" x:Uid="CloseAllButton" Style="{StaticResource ClashTrayCompactButtonStyle}" Click="CloseAllButton_Click" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ClashTrayCardStyle}">
            <StackPanel Spacing="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" x:Uid="ConnectionsSearchBox" TextChanged="SearchBox_TextChanged" />
                    <ComboBox x:Name="SortBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged" MinWidth="84">
                        <ComboBoxItem x:Uid="SortNewestItem" Tag="newest" />
                        <ComboBoxItem x:Uid="SortUploadItem" Tag="upload" />
                        <ComboBoxItem x:Uid="SortDownloadItem" Tag="download" />
                    </ComboBox>
                </Grid>
                <TextBlock x:Name="ListSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ClashTrayCardStyle}" Padding="8">
            <Grid MinHeight="80">
                <ListView x:Name="ConnectionsListView"
                          ItemContainerStyle="{StaticResource ClashTrayListViewItemStyle}"
                          SelectionMode="Single"
                          SelectionChanged="ConnectionsListView_SelectionChanged"
                          ScrollViewer.VerticalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ConnectionRowViewModel">
                            <TextBlock Text="{x:Bind DisplayText, Mode=OneWay}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyListText" x:Uid="ConnectionsEmptyListText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource ClashTrayCardStyle}">
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE946;" FontSize="17" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Uid="ConnectionDetailsTitle" Margin="9,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="2" x:Name="CloseSelectedButton" x:Uid="CloseSelectedButton" Style="{StaticResource ClashTrayCompactButtonStyle}" Click="CloseSelectedButton_Click" />
                </Grid>
                <TextBlock x:Name="DetailsText" x:Uid="ConnectionDetailsText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
