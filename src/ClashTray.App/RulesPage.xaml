<UserControl
    x:Class="ClashTray.App.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="10" Padding="0,2,0,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8FD;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1">
                <TextBlock Text="规则" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="查看当前连接匹配到的 Mihomo 规则" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource ClashTrayCardStyle}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="搜索规则、域名或策略" TextChanged="SearchBox_TextChanged" />
                <ComboBox x:Name="FilterBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="FilterBox_SelectionChanged" MinWidth="84">
                    <ComboBoxItem Content="全部" />
                    <ComboBoxItem Content="域名" />
                    <ComboBoxItem Content="IP" />
                </ComboBox>
            </Grid>
        </Border>

        <Border Style="{StaticResource ClashTrayCardStyle}" Padding="8"><Grid MinHeight="80"><ListView x:Name="RulesListView" AutomationProperties.Name="规则列表" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" /><TextBlock x:Name="EmptyListText" Text="没有可显示的规则" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></Border>
    </StackPanel>
</UserControl>
