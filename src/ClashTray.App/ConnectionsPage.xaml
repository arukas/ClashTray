<UserControl
    x:Class="ClashTray.App.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="10" Padding="0,2,0,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE71B;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="10,0,8,0" Spacing="1">
                <TextBlock x:Uid="ConnectionsTitle" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Uid="ConnectionsSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" x:Uid="CloseAllButton" Style="{StaticResource ClashTrayCompactButtonStyle}" Click="CloseAllButton_Click" />
        </Grid>

        <Border Style="{StaticResource ClashTrayCardStyle}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" x:Uid="ConnectionsSearchBox" TextChanged="SearchBox_TextChanged" />
                <ComboBox x:Name="SortBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged" MinWidth="84">
                    <ComboBoxItem x:Uid="SortNewestItem" Tag="newest" />
                    <ComboBoxItem x:Uid="SortUploadItem" Tag="upload" />
                    <ComboBoxItem x:Uid="SortDownloadItem" Tag="download" />
                </ComboBox>
            </Grid>
        </Border>

        <Border Style="{StaticResource ClashTrayCardStyle}" Padding="8"><Grid MinHeight="80"><ListView x:Name="ConnectionsListView" SelectionChanged="ConnectionsListView_SelectionChanged" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" /><TextBlock x:Name="EmptyListText" x:Uid="ConnectionsEmptyListText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></Border>

        <Border Style="{StaticResource ClashTrayCardStyle}">
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE946;" FontSize="17" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Uid="ConnectionDetailsTitle" Margin="9,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="2" x:Uid="CloseSelectedButton" Style="{StaticResource ClashTrayCompactButtonStyle}" Click="CloseSelectedButton_Click" />
                </Grid>
                <TextBlock x:Name="DetailsText" x:Uid="ConnectionDetailsText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
