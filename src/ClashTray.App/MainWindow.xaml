<Window
    x:Class="ClashTray.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ClashTray">
    <Grid x:Name="RootGrid" Padding="20" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="ClashTray" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="轻量、可靠的 Mihomo 控制中心" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="PinButton" Grid.Column="1" Content="固定" Click="PinButton_Click" AutomationProperties.Name="固定控制面板" />
        </Grid>

        <Border Grid.Row="1" Margin="0,20,0,16" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="核心状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="CoreStateText" Text="已停止" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="CoreVersionText" Text="版本未知" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TrafficText" Text="上传 0 B/s · 下载 0 B/s" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="CoreActionButton" Grid.Column="1" Content="启动" Click="CoreActionButton_Click" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock Text="快速控制" FontSize="16" FontWeight="SemiBold" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SystemProxyButton" Grid.Column="0" Click="SystemProxyButton_Click" HorizontalContentAlignment="Stretch" Padding="14" AutomationProperties.Name="系统代理">
                        <StackPanel Spacing="3">
                            <TextBlock Text="系统代理" FontWeight="SemiBold" />
                            <TextBlock x:Name="SystemProxyStateText" Text="已关闭" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TunButton" Grid.Column="1" Click="TunButton_Click" HorizontalContentAlignment="Stretch" Padding="14" AutomationProperties.Name="TUN">
                        <StackPanel Spacing="3">
                            <TextBlock Text="TUN" FontWeight="SemiBold" />
                            <TextBlock x:Name="TunStateText" Text="已关闭" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Text="代理模式" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RuleModeButton" Content="规则" Click="RuleModeButton_Click" />
                    <Button x:Name="GlobalModeButton" Content="全局" Click="GlobalModeButton_Click" />
                    <Button x:Name="DirectModeButton" Content="直连" Click="DirectModeButton_Click" />
                </StackPanel>
                <Border Padding="14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="当前配置" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ConfigurationText" Text="尚未导入配置" FontSize="15" />
                        <ComboBox x:Name="ConfigurationsComboBox" PlaceholderText="选择配置" SelectionChanged="ConfigurationsComboBox_SelectionChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="导入 YAML" Click="ImportLocalButton_Click" />
                            <Button Content="添加订阅" Click="ImportSubscriptionButton_Click" />
                            <Button Content="刷新" Click="RefreshConfigurationButton_Click" />
                            <Button Content="删除" Click="DeleteConfigurationButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="更多功能" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="规则" Click="RulesButton_Click" />
                    <Button Grid.Column="1" Content="连接" Click="ConnectionsButton_Click" />
                    <Button Grid.Column="2" Content="日志" Click="LogsButton_Click" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,12,0,0">
                    <Button x:Name="ProxyPageButton" Content="代理" Click="ProxyPageButton_Click" />
                    <Button x:Name="RulesPageButton" Content="规则" Click="RulesPageButton_Click" />
                    <Button x:Name="ConnectionsPageButton" Content="连接" Click="ConnectionsPageButton_Click" />
                    <Button x:Name="LogsPageButton" Content="日志" Click="LogsPageButton_Click" />
                    <Button x:Name="SettingsPageButton" Content="设置" Click="SettingsPageButton_Click" />
                </StackPanel>
                <ContentControl x:Name="PageContent" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="ClashTray v0.1 · Mihomo" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="退出" Click="QuitButton_Click" AutomationProperties.Name="退出 ClashTray" />
        </Grid>
    </Grid>
</Window>
